# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-in-production

# Database (PostgreSQL)
# Example: postgresql://user:password@localhost:5432/todo_list?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todo_list?schema=public"

# AI (LLM) integration
# Set your provider API key here (e.g., OpenAI, Anthropic, etc.)
AI_PROVIDER=openai
AI_API_KEY=your_api_key
AI_MODEL=gpt-4o-mini

# App
APP_NAME=Smart To-Do List
APP_URL=http://localhost:3000
